diff -ruN a/tests/nginx-mcp.test.sh b/tests/nginx-mcp.test.sh
--- a/tests/nginx-mcp.test.sh	1970-01-01 09:00:00
+++ b/tests/nginx-mcp.test.sh	2026-11-01 14:40:22
@@ -0,0 +1,122 @@
+#!/usr/bin/env bash
+# shellcheck disable=SC2329  # test_* は declare -F 経由で呼ぶ
+# Docker が要る。本物の compose/docker-compose.yml と nginx/mattermost.conf を使い、mattermost と mcp だけを
+# 要求のパスを返す nginx のスタブに差し替える（ネットワークとエイリアスの定義まで含めて確かめるため）。
+set -uo pipefail
+
+here=$(cd "$(dirname "$0")" && pwd)
+infra=$(cd "$here/.." && pwd)
+work=$(mktemp -d)
+proj="nginx-mcp-test-$$"
+dc() { docker compose -p "$proj" --env-file "$infra/compose/env.example" -f "$infra/compose/docker-compose.yml" -f "$work/override.yml" "$@"; }
+trap 'dc down -v --remove-orphans >/dev/null 2>&1; rm -rf "$work"' EXIT
+
+: >"$work/access.conf"
+mkdir "$work/certbot"
+openssl req -x509 -newkey rsa:2048 -nodes -days 1 -subj /CN=mattermost.example.com \
+  -keyout "$work/key.pem" -out "$work/cert.pem" 2>/dev/null
+chmod 644 "$work/key.pem"
+# shellcheck disable=SC2016  # $request_uri は nginx の変数
+stub() { printf 'server { listen %s; location / { return 200 "%s $request_uri\\n"; } }\n' "$1" "$2"; }
+stub 8065 mattermost >"$work/stub-mattermost.conf"
+stub 3000 mcp >"$work/stub-mcp.conf"
+cat >"$work/override.yml" <<EOF
+services:
+  nginx:
+    ports: !reset []
+    volumes: !override
+      - $infra/nginx/mattermost.conf:/etc/nginx/conf.d/default.conf:ro
+      - $work/access.conf:/etc/nginx/access.conf:ro
+      - $work/cert.pem:/cert.pem:ro
+      - $work/key.pem:/key.pem:ro
+      - $work/certbot:/var/www/certbot:ro
+  mattermost:
+    image: nginx:1.28
+    ports: !reset []
+    depends_on: !reset []
+    volumes: !override
+      - $work/stub-mattermost.conf:/etc/nginx/conf.d/default.conf:ro
+  mcp:
+    image: nginx:1.28
+    build: !reset null
+    read_only: false
+    healthcheck: { disable: true }
+    logging: !override { driver: json-file }
+    volumes: !override
+      - $work/stub-mcp.conf:/etc/nginx/conf.d/default.conf:ro
+EOF
+
+req() { dc exec -T nginx curl -sk "https://127.0.0.1$1"; }
+eq() { [ "$1" = "$2" ] || { echo "  expected '$2' got '$1'"; return 1; }; }
+routes_to() { local p; for p in "${@:2}"; do eq "$(req "$p")" "$1 $p" || return 1; done; }
+wait_for() { for _ in $(seq 30); do [ "$(req "$1")" = "$2 $1" ] && return 0; sleep 1; done; echo "  $1 did not reach $2"; return 1; }
+nginx_ips() { docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}} {{end}}' "$(dc ps -q nginx)"; }
+nginx_mcp_net_ip() { docker inspect -f "{{with index .NetworkSettings.Networks \"${proj}_mcp_net\"}}{{.IPAddress}}{{end}}" "$(dc ps -q nginx)"; }
+
+test_nginx_config_is_valid() {
+  local out; out=$(dc exec -T nginx nginx -t 2>&1) || { echo "$out"; return 1; }
+}
+
+test_mcp_paths_route_to_mcp() {
+  routes_to mcp /mcp /mcp/oauth/token /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server/mcp
+}
+
+test_mcp_path_ending_in_websocket_routes_to_mcp() {
+  routes_to mcp /mcp/x/api/v4/websocket
+}
+
+test_mattermost_paths_route_to_mattermost() {
+  routes_to mattermost / /api/v4/users/me /.well-known/oauth-authorization-server /api/v4/websocket /api/v4/users/websocket
+}
+
+test_nginx_starts_and_serves_mattermost_without_mcp() {
+  dc stop mcp >/dev/null 2>&1 && dc restart nginx >/dev/null 2>&1 || return 1
+  local ok=0; wait_for / mattermost || ok=1
+  dc start mcp >/dev/null 2>&1; wait_for /mcp mcp || ok=1
+  return "$ok"
+}
+
+test_site_name_resolves_to_nginx_only_inside_mcp() {
+  local ip ip_all from_mm from_mcp
+  ip=$(nginx_mcp_net_ip); ip_all=$(nginx_ips)
+  [ -n "$ip" ] || { echo "  nginx is not on mcp_net"; return 1; }
+  from_mcp=$(dc exec -T mcp getent hosts mattermost.example.com | awk '{print $1}')
+  eq "$from_mcp" "$ip" || return 1
+  from_mm=$(dc exec -T mattermost getent hosts mattermost.example.com | awk '{print $1}')
+  for a in $ip_all; do
+    if grep -qx "$a" <<<"$from_mm"; then echo "  mattermost resolves the site to nginx ($a)"; return 1; fi
+  done
+}
+
+# 他のテストが 127.0.0.1 から送る分と枠を分けるため、mattermost のスタブから nginx へ送る。
+# 枠は全パスで共有なので、2 回目以降の連射は 200 を含まないことがある。429 が混じり、200 と 429 以外がないことだけを見る。
+burst_is_limited() {
+  local args=() codes
+  for _ in $(seq 40); do args+=(-o /dev/null "https://nginx$1"); done
+  codes=$(dc exec -T mattermost curl -sk -w '%{http_code}\n' "${args[@]}")
+  if grep -qx 429 <<<"$codes" && ! grep -qvxE '200|429' <<<"$codes"; then return 0; fi
+  echo "  $1 codes: $(sort <<<"$codes" | uniq -c | tr '\n' ' ')"; return 1
+}
+
+test_register_burst_is_rate_limited() {
+  burst_is_limited /mcp/oauth/register
+}
+
+# Express はパスの大文字小文字と末尾のスラッシュを区別しないため、その変形でも枠を逃れられないこと
+test_oauth_path_variants_are_rate_limited() {
+  local p ok=0
+  for p in /mcp/oauth/register/ /mcp/oauth/REGISTER /mcp/OAUTH/register /mcp/oauth/Token; do
+    eq "$(req "$p")" "mcp $p" || ok=1
+    burst_is_limited "$p" || ok=1
+  done
+  return "$ok"
+}
+
+dc up -d --no-deps nginx mattermost mcp >"$work/up.log" 2>&1 || { cat "$work/up.log"; exit 1; }
+wait_for / mattermost || { echo "nginx did not come up"; dc logs nginx | tail -20; exit 1; }
+
+fail=0
+for t in $(declare -F | awk '{print $3}' | grep '^test_'); do
+  if "$t"; then echo "PASS $t"; else echo "FAIL $t"; fail=1; fi
+done
+exit $fail

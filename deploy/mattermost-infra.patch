@@ -28,6 +29,7 @@
     # upstream ブロックは起動・reload 時に名前解決するため使わない。Mattermost 停止中でも reload で許可リストを差し替えられるようにする
     resolver 127.0.0.11 valid=10s;
     set $mattermost_upstream http://mattermost:8065;
+    set $mcp_upstream http://mcp:3000;
 

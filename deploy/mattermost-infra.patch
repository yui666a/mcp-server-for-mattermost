diff -ruN a/compose/docker-compose.yml b/compose/docker-compose.yml
--- a/compose/docker-compose.yml	2026-11-01 14:40:22
+++ b/compose/docker-compose.yml	2026-11-01 14:40:22
@@ -48,3 +48,41 @@
       - /srv/certs/fullchain.pem:/cert.pem:ro
       - /srv/certs/privkey.pem:/key.pem:ro
       - /srv/certbot:/var/www/certbot:ro
+    # default に付けると mattermost からも自サイトの名前がプライベート IP に解決され、外向き通信が予約済み IP として拒否されうる
+    networks:
+      default: {}
+      mcp_net:
+        aliases:
+          - mattermost.example.com
+
+  mcp:
+    build: ../../mattermost-mcp
+    restart: unless-stopped
+    security_opt:
+      - no-new-privileges:true
+    read_only: true
+    tmpfs:
+      - /tmp
+    # 送信中の send_message が呼び出しの期限（25 秒）まで走り切れるように、既定の 10 秒より長く待つ
+    stop_grace_period: 40s
+    environment:
+      PUBLIC_URL: ${PUBLIC_URL}
+      MM_OAUTH_CLIENT_ID: ${MM_OAUTH_CLIENT_ID}
+      MM_OAUTH_CLIENT_SECRET: ${MM_OAUTH_CLIENT_SECRET}
+      TOKEN_ENC_KEY: ${TOKEN_ENC_KEY}
+      DB_PATH: /data/mcp.sqlite
+    # コンテナ内は UID 1000（node）。ホスト側は事前に chown 1000:1000 しておく
+    volumes:
+      - /srv/mcp:/data
+    cpus: 0.5
+    mem_limit: 256m
+    pids_limit: 128
+    logging:
+      driver: journald
+    healthcheck:
+      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/mcp/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
+    networks:
+      - mcp_net
+
+networks:
+  mcp_net: {}

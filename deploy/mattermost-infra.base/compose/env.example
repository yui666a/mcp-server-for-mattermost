# cp env.example .env して使う。.env は commit しない。

MATTERMOST_IMAGE_TAG=11.7.8

# PostgreSQL 18 以降はデータ置き場が /var/lib/postgresql（バージョン別サブディレクトリを自動作成する）。
POSTGRES_IMAGE_TAG=18.6
POSTGRES_DATA_MOUNT=/var/lib/postgresql
# 17 系へ切り戻す場合は次の 2 行に差し替える（17 は /var/lib/postgresql/data）。
# POSTGRES_IMAGE_TAG=17.11
# POSTGRES_DATA_MOUNT=/var/lib/postgresql/data

# 英数字のみ 32 文字で生成すること（例: openssl rand -hex 16）。
# SQL と接続 URL でエスケープしない前提のため、記号を含めてはいけない。
POSTGRES_PASSWORD=
MMUSER_PASSWORD=
